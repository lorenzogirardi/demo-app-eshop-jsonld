# Copy to .env.enthusiast (scripts/setup.sh does this and fills the secrets for you).
# Never commit the real .env.enthusiast.

ECL_DB_USER=enthusiast
ECL_DB_PASSWORD=__GENERATED__
ECL_DB_NAME=enthusiast

ECL_DJANGO_SECRET_KEY=__GENERATED__
ECL_ADMIN_EMAIL=admin@example.com
ECL_ADMIN_PASSWORD=__GENERATED__

# eShop catalog export token: same value as ENTHUSIAST_TOKEN in .env
ESHOP_DUMP_TOKEN=__GENERATED__

# OpenRouter key used by Enthusiast for its agent (same key as OPENAI_API_KEY in .env)
OPENAI_API_KEY=__YOUR_OPENROUTER_KEY__
