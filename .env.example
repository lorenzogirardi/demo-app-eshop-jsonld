# Copy to .env (scripts/setup.sh does this and fills the secrets for you).
# Never commit the real .env.

# Demo mode: catalog and carts are in-memory, the database is not used at runtime
DATABASE_URL=mongodb://localhost:27017/demo-app
NEXTAUTH_SECRET=__GENERATED__
NEXTAUTH_URL=http://localhost:3000
URL=http://localhost:3000

# AI feature flags
AI_ENABLED=true
AI_FALLBACK=true
AI_LOG_LEVEL=info
# enthusiast: search and chat go through the Enthusiast agent first; direct: straight to the LLM
AI_BACKEND=enthusiast

# LLM provider (OpenRouter-compatible). THE ONLY VALUE YOU MUST SUPPLY.
LLM_PROVIDER=openrouter
OPENAI_API_KEY=__YOUR_OPENROUTER_KEY__
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=60000

# Enthusiast sidecar (same token as ESHOP_DUMP_TOKEN in .env.enthusiast)
ENTHUSIAST_URL=http://enthusiast-api:10000
ENTHUSIAST_TOKEN=__GENERATED__

# Admin token for /admin pages (sent as Authorization: Bearer <token>)
ADMIN_TOKEN=__GENERATED__
